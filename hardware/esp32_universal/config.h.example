// ZIAS ESP32 Universal Node — configuration template.
// Copy to config.h and customize per device. Never commit config.h.

#ifndef ZIAS_CONFIG_H
#define ZIAS_CONFIG_H

// ---- Wi-Fi ----
#define WIFI_SSID                "your_wifi_network"
#define WIFI_PASSWORD            "your_wifi_password"
#define WIFI_CONNECT_TIMEOUT     20000  // ms

// ---- Identity ----
#define DEVICE_NAME              "room101_door_in"
#define DEVICE_DIRECTION         "entry"   // "entry" | "exit"
#define CLUSTER_ID               101

// ---- MQTT ----
#define MQTT_BROKER              "raspberrypi.local"
#define MQTT_PORT                1883
#define MQTT_TOPIC_PREFIX        "zias"
// If your broker requires auth (recommended), uncomment:
// #define MQTT_USERNAME         "zias-node"
// #define MQTT_PASSWORD         "change_me"
#define MQTT_RECONNECT_DELAY     5000

// ---- Pins (ESP32 default SPI is MOSI=23 MISO=19 SCK=18) ----
#define GPIO_RFID_RST            22
#define GPIO_RFID_SS             21
#define GPIO_PIR                 4
#define LED_BUILTIN              2

// ---- Timing ----
#define PIR_DEBOUNCE_MS          1500
#define RFID_COOLDOWN_MS         3000     // suppress duplicate scan of same card
#define HEARTBEAT_INTERVAL_MS    60000
#define OFFLINE_QUEUE_MAX        32
#define WDT_TIMEOUT_SECONDS      30

// ---- NTP ----
#define NTP_SERVER               "pool.ntp.org"
#define TZ_OFFSET_SECONDS        19800    // +05:30 for India

// ---- Optional: BLE beacon ----
// #define ENABLE_BLE
// #define BLE_BEACON_UUID       "b5b182c7-eab1-4988-aa99-b5c1517008d9"

// ---- Optional: ESP32-CAM ----
// #define CAMERA_MODEL_AI_THINKER

#endif
