# ZIAS environment variables — copy to .env and fill in every value.
# NEVER commit .env. chmod 600 recommended.

# ---- Database (MariaDB via docker-compose) ----
DB_HOST=db
DB_PORT=3306
DB_NAME=iot_data
DB_USER=zias
DB_PASSWORD=change_me_now
DB_ROOT_PASSWORD=change_me_root

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---- MQTT (Mosquitto with auth) ----
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_BACKEND_USER=zias-backend
MQTT_BACKEND_PASSWORD=change_me_mqtt
MQTT_TLS=false
MQTT_TOPIC_PREFIX=zias

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# ---- JWT ----
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=please_replace_with_a_random_32_char_or_longer_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---- CORS (comma-separated) ----
CORS_ORIGINS=http://localhost,http://localhost:5173

# ---- Attendance behavior ----
ATTENDANCE_WINDOW_SECONDS=10
ANTI_TAILGATING_DELAY_SECONDS=3

# ---- BLE (optional) ----
BLE_TIMEOUT_SECONDS=300
BLE_GEOFENCE_RADIUS_METERS=50

# ---- First admin (seeded once on startup) ----
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=change_me_admin

# ---- Frontend build ----
# When accessing the frontend on http://<pi>/ the API is proxied by nginx,
# so a relative URL is correct. Change only for cross-origin setups.
VITE_API_URL=/
